<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.READ_CALENDAR"/>
    <uses-permission android:name="android.permission.WRITE_CALENDAR"/>
    <!--
      USE_EXACT_ALARM（Android 14 / API 34 起引入）：精确闹钟权限。

      【为什么不用 SCHEDULE_EXACT_ALARM（API 33+）】
      - SCHEDULE_EXACT_ALARM 需要用户**手动授权**「闹钟和提醒」，且用户**可随时撤销**；
        一旦被撤销，上下班提醒会静默失效，而用户往往不知道自己关掉了它 —— 提醒是本应用的核心功能。
      - USE_EXACT_ALARM 是 normal 权限，安装即授予、无需任何用户交互 → 提醒链路可靠。

      【为什么符合 Google Play 政策】
      IDE 在此处提示「will be automatically granted to apps with core functions needing precise
      timing (alarms, calendars). You'll need to justify the need for this API.」——
      本应用的核心功能正是**排班日历 + 上下班精确提醒**，同时命中该政策明确列出的
      许可用例（alarms / calendars），因此属政策允许范围，无需申请豁免。
      若将来上架 Google Play，需在 Play Console 的 justification 中填写同样理由。

      【技术前提】
      - minSdk = 34（Android 14+），USE_EXACT_ALARM 自 API 34 引入，故无需兼容旧版本分支；
      - 提醒统一用 AlarmManager.setAlarmClock —— 被系统视为「用户设置的闹钟」，
        在 Doze / 省电模式下同样准时触发，且不在系统闹钟 UI 留记录。
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.AUTHENTICATE_ACCOUNTS"/>
    <!--
      电池优化豁免：跳系统「忽略电池优化」确认页的必要权限（normal 权限，安装即授予）。

      - 缺了它：系统的 RequestIgnoreBatteryOptimizations 页会校验调用方权限 → 无权限直接退出；
        而**应用侧 startActivity 不会抛异常** → 表现为「点「前往设置」完全没反应」
        （无界面、无异常、无提示，纯静默失败）。
      - 授予后：会弹出系统的「是否允许本应用忽略电池优化」确认框，用户点确定即完成豁免。
      - 注：Google Play 对该权限有政策要求（需属许可用例并申请豁免）；
        本应用走国内分发/自用，不受 Play 审核约束。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <!--
      关闭系统「预测式返回」（Predictive Back）：

      - Android 16 / targetSdk 36 起该特性默认开启，系统会在返回时给整个窗口套一层**缩放**动画；
        它与应用内的导航转场叠加，导致"退出二级页时页面像被直接缩放"，且完全不受应用层控制。
      - 关闭后：返回逻辑仍由 androidx.activity 的 BackHandler / OnBackPressedDispatcher 处理
        （功能不受影响，根 Tab 页返回退出、日历子模式拦截等行为都不变），
        而**转场动画完全交给应用** —— 即 AppNavHost 里配置的
        enterTransition / exitTransition / popEnterTransition / popExitTransition。
    -->
    <application
        android:name=".ScheduleApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScheduleCalendar"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ScheduleCalendar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- 文件分享 FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

        <!-- 桌面小组件（Jetpack Glance，Compose-first，无 RemoteViews） -->
        <receiver
            android:name=".widget.ScheduleGlanceReceiver"
            android:label="@string/widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_info"/>
        </receiver>

        <!-- 日历网格小组件（3x3 日期 + 班次） -->
        <receiver
            android:name=".widget.CalendarGlanceReceiver"
            android:label="@string/calendar_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_widget_info"/>
        </receiver>

        <!-- 日历网格小组件（3x4 日期 + 班次 + 附加状态） -->
        <receiver
            android:name=".widget.CalendarGlance3x4Receiver"
            android:label="@string/calendar_3x4_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_3x4_widget_info"/>
        </receiver>

        <!-- 小组件配置 Activity（应用内启动：点小组件 / 「组件设置」页）
             ⚠️ exported="false"：只由本应用内的**显式 Intent** 启动，不需要对外暴露。
             旧配置里的 APPWIDGET_CONFIGURE intent-filter 已移除：三个 widget_info.xml
             都没有声明 android:configure，桌面启动器根本不会走这个入口 ——
             留着只是白白多一个「任何应用都能拉起」的入口。 -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="false"
            android:theme="@style/Theme.ScheduleCalendar" />

        <!-- 一键添加小组件成功回调（仅由本应用 PendingIntent 显式触发，无需导出） -->
        <receiver
            android:name=".widget.WidgetPinnedReceiver"
            android:exported="false" />

        <!-- 小组件精确刷新闹钟接收器（由 WidgetRefreshScheduler 以显式 Intent 触发，无需 intent-filter） -->
        <receiver
            android:name=".widget.WidgetRefreshReceiver"
            android:exported="false" />

        <!-- 上下班提醒闹钟接收器 -->
        <receiver
            android:name=".reminder.AlarmReceiver"
            android:exported="false" />

        <!-- 纪念日提醒接收器 -->
        <receiver
            android:name=".reminder.AnniversaryReminderReceiver"
            android:exported="false" />

        <!-- 开机自启动接收器：设备重启 / 应用更新后重新调度闹钟提醒 -->
        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 时间/时区变更接收器：跨时区飞行或手动改时间后，修正已注册的绝对毫秒闹钟 -->
        <receiver
            android:name=".reminder.TimeChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 日历账户认证器服务
             ⚠️ 必须 exported="true"：系统 AccountManager 是通过**隐式 Intent** 来绑定
                AccountAuthenticator 服务的；exported="false" 会让系统绑不上 →
                应用日历账户无法出现在系统「账户」管理里，也无法被日历应用识别。
             安全靠系统权限兜底：android.permission.ACCOUNT_MANAGER 是系统级权限，
             第三方应用拿不到 → 只有系统能绑定。 -->
        <service
            android:name=".data.calendar.CalendarAuthenticatorService"
            android:exported="true"
            android:permission="android.permission.ACCOUNT_MANAGER">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>

    </application>
</manifest>
